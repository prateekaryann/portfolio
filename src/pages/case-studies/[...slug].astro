---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const entries = (await getCollection('case-studies')).sort((a, b) => a.data.order - b.data.order);
  return entries.map((entry, i) => ({
    params: { slug: entry.id },
    props: { entry, prev: entries[i - 1] ?? null, next: entries[i + 1] ?? null },
  }));
}

interface Props {
  entry: CollectionEntry<'case-studies'>;
  prev: CollectionEntry<'case-studies'> | null;
  next: CollectionEntry<'case-studies'> | null;
}

const { entry, prev, next } = Astro.props;
const { Content, headings } = await render(entry);
const { title, subtitle, description, stack, publishedAt, accent, order } = entry.data;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const toc = headings.filter((h) => h.depth === 2);
const readMins = Math.max(2, Math.round((entry.body?.split(/\s+/).length ?? 0) / 200));
const dateStr = new Date(publishedAt).toLocaleDateString('en-US', { year: 'numeric', month: 'short' });

const ACCENTS: Record<string, [string, string]> = {
  violet: ['#a78bfa', '#22d3ee'], cyan: ['#22d3ee', '#0ea5e9'], indigo: ['#818cf8', '#c084fc'],
  amber: ['#f5b14c', '#ec4899'], teal: ['#2dd4bf', '#22d3ee'], pink: ['#ec4899', '#a78bfa'],
};
const [a, b] = ACCENTS[accent] ?? ACCENTS.violet;
const banner = `<svg viewBox="0 0 1200 320" preserveAspectRatio="xMidYMid slice" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
  <defs>
    <linearGradient id="bn" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="${a}"/><stop offset="1" stop-color="${b}"/></linearGradient>
    <radialGradient id="bnr" cx="0.8" cy="0.2" r="0.7"><stop offset="0" stop-color="#fff" stop-opacity="0.4"/><stop offset="0.7" stop-color="#fff" stop-opacity="0"/></radialGradient>
  </defs>
  <rect width="1200" height="320" fill="url(#bn)"/><rect width="1200" height="320" fill="url(#bnr)"/>
  <g fill="none" stroke="#fff" stroke-opacity="0.2" stroke-width="1.5">
    <circle cx="980" cy="110" r="60"/><circle cx="980" cy="110" r="110"/><circle cx="980" cy="110" r="165"/>
    <path d="M80 250 L260 180 L440 230 L620 150 L820 210 L1050 130"/>
  </g>
  <g fill="#fff" fill-opacity="0.85"><circle cx="80" cy="250" r="6"/><circle cx="260" cy="180" r="6"/><circle cx="440" cy="230" r="6"/><circle cx="620" cy="150" r="6"/><circle cx="820" cy="210" r="6"/></g>
  <text x="70" y="130" font-family="'Space Grotesk',sans-serif" font-size="150" font-weight="700" fill="#fff" fill-opacity="0.85">0${order}</text>
</svg>`;
---

<Base title={`${title} — Prateek Aryan`} description={description}>
  <div class="read-progress" id="read-progress"></div>

  <header class="cs-masthead wrap narrow">
    <a href={`${base}/#case-studies`} class="back">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M19 12H5M11 18l-6-6 6-6"/></svg> All case studies
    </a>
    <h1 data-reveal>{title}</h1>
    {subtitle && <p class="sub" data-reveal data-delay="1">{subtitle}</p>}
    <div class="masthead-meta" data-reveal data-delay="1">
      <span><b>{dateStr}</b></span><span><b>{readMins} min</b> read</span><span><b>{stack[0]}</b></span>
    </div>
    <div class="chips" data-reveal data-delay="2">{stack.map((s) => <span class="chip">{s}</span>)}</div>
    <div class="cs-banner" data-reveal data-delay="2" set:html={banner} />
  </header>

  <div class="wrap narrow cs-layout">
    <article class="prose" id="article"><Content /></article>
    {toc.length > 2 && (
      <aside class="toc" aria-label="Table of contents">
        <div class="toc-title">On this page</div>
        <ul>{toc.map((h) => <li><a href={`#${h.slug}`} data-toc={h.slug}>{h.text}</a></li>)}</ul>
      </aside>
    )}
  </div>

  <div class="wrap narrow">
    <nav class="cs-nav">
      {prev ? (
        <a class="glass prev" href={`${base}/case-studies/${prev.id}/`}><span class="dir">← Previous</span><span class="t">{prev.data.title}</span></a>
      ) : <span />}
      {next ? (
        <a class="glass next" href={`${base}/case-studies/${next.id}/`}><span class="dir">Next →</span><span class="t">{next.data.title}</span></a>
      ) : <span />}
    </nav>

    <section class="block" style="text-align:center; padding-block: 3.5rem 1rem;">
      <h2 style="border:0; margin-bottom:1rem;">Want the full story?</h2>
      <div class="cta-actions">
        <a href="mailto:prateekaryyan@gmail.com" class="btn btn-primary">Get in touch</a>
        <a href={`${base}/#case-studies`} class="btn btn-ghost">More case studies</a>
      </div>
    </section>
  </div>

  <script>
    function initArticle() {
      const bar = document.getElementById('read-progress');
      const article = document.getElementById('article');
      if (!bar || !article) return;
      const onScroll = () => {
        const top = article.offsetTop;
        const h = article.offsetHeight - window.innerHeight;
        const p = Math.min(1, Math.max(0, (window.scrollY - top) / Math.max(1, h)));
        bar.style.width = (p * 100) + '%';
      };
      onScroll();
      window.addEventListener('scroll', onScroll, { passive: true });

      const links = Array.from(document.querySelectorAll('[data-toc]'));
      if (links.length) {
        const spy = new IntersectionObserver((entries) => {
          entries.forEach((e) => {
            if (e.isIntersecting) {
              const id = e.target.getAttribute('id');
              links.forEach((l) => l.classList.toggle('active', l.getAttribute('data-toc') === id));
            }
          });
        }, { rootMargin: '-20% 0px -70% 0px' });
        document.querySelectorAll('#article h2[id]').forEach((h) => spy.observe(h));
      }
    }
    document.addEventListener('astro:page-load', initArticle);
  </script>
</Base>
