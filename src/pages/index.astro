---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { panel } from '../lib/covers';
import Scene from '../components/three/Scene';
import Terminal from '../components/Terminal';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const studies = (await getCollection('case-studies'))
  .filter((e) => e.data.featured)
  .sort((a, b) => a.data.order - b.data.order);

const readMins = (e) => Math.max(2, Math.round((e.body?.split(/\s+/).length ?? 0) / 200));

const CS_GLYPH = { 0: 'llm', 1: 'speed', 2: 'workflow', 3: 'failover', 4: 'shield', 5: 'dbupgrade' };
const cover = (e) => panel(e.data.accent ?? 'violet', CS_GLYPH[e.data.order] ?? 'llm', 'cs' + e.data.order, 168);

const skills = [
  { icon: 'server', title: 'Backend', items: ['Python', 'FastAPI', 'PostgreSQL', 'SQLAlchemy', 'gRPC', 'REST'] },
  { icon: 'brain', title: 'AI / LLM', items: ['RAG pipelines', 'Prompt caching', 'Model tiering', 'Agent orchestration', 'Bedrock / Claude', 'OpenSearch'] },
  { icon: 'cloud', title: 'Cloud & DevOps', items: ['AWS', 'EKS / K8s', 'Docker', 'Terraform', 'Helm', 'CI/CD'] },
  { icon: 'data', title: 'Data & Systems', items: ['Distributed systems', 'MongoDB', 'Redis', 'Kafka', 'Step Functions', 'Observability'] },
];

const whatIDo = [
  { title: 'Distributed backends', sub: 'Systems that stay up', body: 'APIs, queues, state machines and switchover automation for services that cannot fall over. Idempotency, fencing, and failure-mode design as first-class work.', tags: ['Python', 'FastAPI', 'PostgreSQL', 'gRPC', 'Redis', 'Kafka'] },
  { title: 'LLM & GenAI platforms', sub: 'Production AI, not demos', body: 'Fault-tolerant LLM orchestration, idempotent RAG pipelines, and cost controls (prompt caching, model tiering) for regulated clinical content generation.', tags: ['RAG', 'Bedrock / Claude', 'Step Functions', 'OpenSearch', 'Evals'] },
  { title: 'Cloud & DevOps', sub: 'Automation over toil', body: 'AWS-native infrastructure, Kubernetes deployments, Terraform, and the CI/CD pipelines that turn 3-hour manual jobs into 10-minute automated ones.', tags: ['AWS', 'EKS / K8s', 'Terraform', 'Docker', 'Helm', 'CI/CD'] },
];

const career = [
  { role: 'Senior Software Engineer II', org: 'UsefulBI · AI Engineer, Gilead Sciences platform', when: 'NOW', body: 'Building the production systems behind automated clinical-document generation (CSR, DSUR, PLPS): fault-tolerant LLM orchestration with durable execution, an idempotent RAG pipeline, and prompt-caching & model-tiering cost controls. Grew out of a clinical-document POC I built and solely owned — the demo that won the engagement.' },
  { role: 'Software Engineer', org: 'Cisco Systems · Bengaluru', when: '2021–25', body: 'Kept 200+ enterprise applications reliable: gRPC-based distributed database switchover automation, MySQL cluster upgrade tooling (1h → 10min), and a SOX compliance reporting pipeline cut from 3+ hours to under 10 minutes.' },
  { role: 'B.E. Computer Science', org: 'BMS College of Engineering · 9.2 GPA', when: '2017–21', body: 'Bengaluru. Certified since: AWS Cloud Practitioner, HashiCorp Terraform Associate, MongoDB DBA, PCAP (Python).' },
];

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);

const termProjects = projects.map((p) => ({ name: p.id, desc: p.data.tagline, path: `${base}/projects/${p.id}/` }));
const termStudies = studies.map((e, i) => ({ n: i + 1, title: e.data.title, path: `${base}/case-studies/${e.id}/` }));

const ICONS = {
  server: '<rect x="3" y="4" width="18" height="7" rx="2"/><rect x="3" y="13" width="18" height="7" rx="2"/><line x1="7" y1="7.5" x2="7" y2="7.5"/><line x1="7" y1="16.5" x2="7" y2="16.5"/>',
  brain: '<path d="M9 3a3 3 0 0 0-3 3 3 3 0 0 0-1 5.8A3 3 0 0 0 7 17a3 3 0 0 0 5 1 3 3 0 0 0 5-1 3 3 0 0 0 2-5.2A3 3 0 0 0 18 6a3 3 0 0 0-3-3 3 3 0 0 0-3 1.5A3 3 0 0 0 9 3Z"/>',
  cloud: '<path d="M17.5 19a4.5 4.5 0 0 0 .5-9 6 6 0 0 0-11.6-1.5A4 4 0 0 0 6.5 19Z"/>',
  data: '<ellipse cx="12" cy="5" rx="8" ry="3"/><path d="M4 5v6c0 1.7 3.6 3 8 3s8-1.3 8-3V5"/><path d="M4 11v6c0 1.7 3.6 3 8 3s8-1.3 8-3v-6"/>',
};
const ico = (n) => `<svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">${ICONS[n]}</svg>`;

const personLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Prateek Aryan',
  jobTitle: 'Senior Software Engineer',
  url: 'https://prateekaryann.github.io/portfolio/',
  email: 'mailto:prateekaryyan@gmail.com',
  sameAs: ['https://github.com/prateekaryann', 'https://linkedin.com/in/prateek-aryan', 'https://medium.com/@prateekaryyan', 'https://x.com/prateekaryyan'],
  address: { '@type': 'PostalAddress', addressLocality: 'Bengaluru', addressCountry: 'IN' },
  knowsAbout: ['Distributed systems', 'LLM systems', 'RAG pipelines', 'Python', 'FastAPI', 'AWS'],
};

const pageTitle = 'Prateek Aryan — Senior Software Engineer · LLM/GenAI & Distributed Systems';
const pageDescription = 'Senior Software Engineer building production LLM/GenAI systems and distributed backends on Python, FastAPI, and AWS. AI Engineer on the Gilead Sciences clinical content-generation platform.';
---

<Base title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={JSON.stringify(personLd)} />

  <Scene client:only="react" base={base} projects={termProjects} studies={termStudies} />

  <!-- ===== 3D STORY: landing → about → what I do → screen → exit ===== -->
  <div id="story">
    <section class="stage landing" id="landing">
      <div class="stage-inner">
        <div class="landing-copy">
          <div class="landing-intro">
            <h2>Hello! I'm</h2>
            <h1>Prateek<br /><span>Aryan</span></h1>
          </div>
          <div class="landing-info">
            <h3>Senior Software Engineer</h3>
            <h2>
              <span class="flip a"><span>Distributed</span><span class="grad-text">LLM</span></span>
              <span class="flip b"><span>Backends</span><span>Platforms</span></span>
            </h2>
          </div>
          <div class="landing-cta">
            <a href="#case-studies" class="btn btn-primary">View case studies</a>
            <a href={`${base}/Prateek_Aryan_Resume.pdf`} class="btn btn-ghost" target="_blank" rel="noopener">Résumé</a>
          </div>
        </div>
        <img class="landing-poster" src={`${base}/models/poster.png`} alt="3D avatar of Prateek Aryan" width="420" height="640" loading="eager" />
        <div class="term-mobile"><Terminal client:only="react" base={base} projects={termProjects} studies={termStudies} /></div>
      </div>
      <div class="scroll-cue" aria-hidden="true"><span>scroll</span><span class="line"></span></div>
    </section>

    <section class="stage about" id="about">
      <div class="stage-inner">
        <div class="about-copy">
          <span class="eyebrow">About me</span>
          <p>
            I build backend and LLM systems that stay up when things get hard — currently as an
            AI Engineer on the Gilead Sciences clinical content-generation platform via UsefulBI.
          </p>
          <p>
            Before that, five years at Cisco Systems keeping 200+ enterprise apps reliable: database
            automation, gRPC switchover systems, and a SOX pipeline cut from 3+ hours to under 10 minutes.
            Python, FastAPI, AWS, and the unglamorous reliability work in between.
          </p>
        </div>
      </div>
    </section>

    <section class="stage whatido" id="whatido">
      <div class="stage-inner">
        <div class="whatido-copy">
          <h2 class="whatido-title">W<em>hat</em><br />I <span>do</span></h2>
          <div class="what-box">
            {whatIDo.map((w, i) => (
              <div class={`what-card${i === 0 ? ' open' : ''}`}>
                <span class="corner"></span>
                <span class="arrow" aria-hidden="true"></span>
                <h3>{w.title}</h3>
                <h4>{w.sub}</h4>
                <p>{w.body}</p>
                <div class="chips">{w.tags.map((t) => <span class="chip">{t}</span>)}</div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="stage screen-stage" id="screen" aria-hidden="true">
      <div class="stage-inner">
        <div class="screen-copy">↳ that terminal is real — click it and type <b>help</b></div>
      </div>
    </section>

    <section class="stage exit-stage" aria-hidden="true"></section>
  </div>

  <!-- ===== CAREER ===== -->
  <section class="block wrap career" id="career">
    <h2 class="career-title">My career <span>&amp;</span><br />experience</h2>
    <div class="career-info" data-reveal>
      <div class="career-timeline"><div class="career-dot"></div></div>
      {career.map((c) => (
        <div class="career-box">
          <div class="career-in">
            <div><h4>{c.role}</h4><h5>{c.org}</h5></div>
            <h3>{c.when}</h3>
          </div>
          <p>{c.body}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- ===== NUMBERS ===== -->
  <section class="block wrap" id="numbers">
    <div class="xp-strip" data-reveal>
      <span class="org">Gilead Sciences</span><span class="org">Cisco Systems</span><span class="org">UsefulBI</span><span class="org">BMS College</span>
    </div>
    <div class="stats narrow" style="margin: 3rem auto 0;">
      <div class="stat" data-reveal><div class="num">5+</div><div class="lbl">Years building production systems</div></div>
      <div class="stat" data-reveal data-delay="1"><div class="num">200+</div><div class="lbl">Enterprise apps supported at Cisco</div></div>
      <div class="stat" data-reveal data-delay="2"><div class="num">99.3%</div><div class="lbl">Latency cut on doc retrieval</div></div>
      <div class="stat" data-reveal data-delay="3"><div class="num">~90%</div><div class="lbl">LLM token-cost reduction</div></div>
    </div>
  </section>

  <!-- ===== CASE STUDIES ===== -->
  <section class="block wrap" id="case-studies">
    <div class="section-head" data-reveal>
      <span class="eyebrow">Case studies</span>
      <h2>Deep dives into real systems I've shipped.</h2>
      <p>Sanitized architectural write-ups — the patterns, trade-offs, and failure-modes are real.</p>
    </div>
    <div class="cs-grid">
      {studies.map((e, i) => (
        <a class={`glass cs-card${e.data.order === 0 ? ' featured' : ''}`} href={`${base}/case-studies/${e.id}/`} data-reveal data-delay={i % 3}>
          <div class="cs-cover" set:html={cover(e)} />
          <div class="cs-body">
            <div class="cs-meta">
              {e.data.order === 0 && <span class="tag-featured">Flagship</span>}
              <span>{e.data.stack[0]}</span><span>·</span><span>{readMins(e)} min read</span>
            </div>
            <h3>{e.data.title}</h3>
            <p class="desc">{e.data.description}</p>
            <div class="cs-foot">
              <div class="chips">{e.data.stack.slice(0, 3).map((s) => <span class="chip">{s}</span>)}</div>
              <span class="arrow">Read
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
              </span>
            </div>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- ===== SKILLS ===== -->
  <section class="block wrap" id="skills">
    <div class="section-head" data-reveal>
      <span class="eyebrow">Toolkit</span>
      <h2>What I work with.</h2>
    </div>
    <div class="skill-grid">
      {skills.map((s, i) => (
        <div class="glass skill-card" data-reveal data-delay={i % 3}>
          <div class="head">
            <span set:html={ico(s.icon)} /><h3>{s.title}</h3>
          </div>
          <div class="chips">{s.items.map((it) => <span class="chip">{it}</span>)}</div>
        </div>
      ))}
    </div>
  </section>

  <!-- ===== PROJECTS ===== -->
  <section class="block wrap" id="projects">
    <div class="section-head" data-reveal>
      <span class="eyebrow">Open source</span>
      <h2>Things I've built for fun &amp; reference.</h2>
    </div>
    <div class="proj-grid">
      {projects.map((p, i) => (
        <a class="glass proj-card" href={`${base}/projects/${p.id}/`} data-reveal data-delay={i % 3}>
          <div class="proj-cover" set:html={panel(p.data.accent, p.data.glyph, p.id, 120)} />
          <div class="proj-body">
            <div class="top">
              <span class="name">
                <svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.5c0-1 .1-1.4-.5-2 2.8-.3 5.5-1.4 5.5-6a4.6 4.6 0 0 0-1.3-3.2 4.2 4.2 0 0 0-.1-3.2s-1.1-.3-3.5 1.3a12 12 0 0 0-6.2 0C6.5 2.8 5.4 3.1 5.4 3.1a4.2 4.2 0 0 0-.1 3.2A4.6 4.6 0 0 0 4 9.5c0 4.6 2.7 5.7 5.5 6-.6.6-.6 1.2-.5 2V21"/></svg>
                {p.data.title}
              </span>
              <svg class="ext" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
            </div>
            <span class="desc">{p.data.tagline}</span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- ===== CONTACT ===== -->
  <section class="block wrap" id="contact">
    <div class="glass cta" data-reveal>
      <span class="eyebrow" style="justify-content:center">Contact</span>
      <h2>Let's build something <span class="grad-text">resilient</span>.</h2>
      <p>Open to senior backend and AI/LLM engineering contracts. The fastest way to reach me is email.</p>
      <div class="cta-actions">
        <a href="mailto:prateekaryyan@gmail.com" class="btn btn-primary">
          <svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m2 7 10 6 10-6"/></svg>
          prateekaryyan@gmail.com
        </a>
        <a href="https://linkedin.com/in/prateek-aryan" class="btn btn-ghost" target="_blank" rel="noopener">LinkedIn</a>
        <a href="https://github.com/prateekaryann" class="btn btn-ghost" target="_blank" rel="noopener">GitHub</a>
      </div>
    </div>
  </section>

  <script>
    // "What I do" cards: click-to-expand on touch devices (hover handles desktop)
    function initCards() {
      document.querySelectorAll('.what-card').forEach((card) => {
        card.addEventListener('click', () => {
          document.querySelectorAll('.what-card').forEach((c) => c !== card && c.classList.remove('open'));
          card.classList.toggle('open');
        });
      });
    }
    document.addEventListener('astro:page-load', initCards);
  </script>
</Base>
